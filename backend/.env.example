DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Stable Fernet key required to encrypt connector credentials. Generate as documented.
CREDENTIAL_KEY=
SESSION_COOKIE_SECURE=false
# Exact host:port allowlist for live HTTP, AI, MCP and browser calls. No wildcard.
TESTPILOT_ALLOWED_TARGETS=127.0.0.1:8766,api.deepseek.com,dashscope.aliyuncs.com,localhost:8931,localhost:8933,192.168.5.195:18741
# Optional, only for Gemini model calls; must be a local HTTP proxy without credentials.
TESTPILOT_GEMINI_PROXY=
# Optional: use an installed Chrome channel or an explicit Chromium executable.
TESTPILOT_BROWSER_CHANNEL=chrome
# TESTPILOT_BROWSER_EXECUTABLE=/absolute/path/to/chromium
# Refer to this as {{secret:DEMO}} in an environment; do not put secrets in JSON.
# TESTPILOT_SECRET_DEMO=replace-me
